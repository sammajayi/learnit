DATABASE_URL=postgresql://user:password@host:5432/learnit
DATABASE_URL_UNPOOLED=postgresql://user:password@host:5432/learnit
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
SIGNER_PRIVATE_KEY=

# mainnet (default) or testnet (Celo Alfajores). On testnet, the addresses below have no safe
# defaults and must be set explicitly to GoodDollar's dev deployment (see their docs) -
# this repo does not guess them.
NEXT_PUBLIC_NETWORK=mainnet
NEXT_PUBLIC_CELO_RPC_URL=https://forno.celo.org
NEXT_PUBLIC_REWARDS_POOL_ADDRESS=
NEXT_PUBLIC_STREAK_VAULT_ADDRESS=
NEXT_PUBLIC_GOODDOLLAR_TOKEN_ADDRESS=0x62B8B11039FcfE5aB0C56E502b1C372A3d2a9c7A
NEXT_PUBLIC_IDENTITY_ADDRESS=0xC361A6E67822a0EDc17D899227dd9FC50BD62F42
NEXT_PUBLIC_UBI_SCHEME_ADDRESS=0x43d72Ff17701B2DA814620735C39C620Ce0ea4A1
# citizen-sdk's `env` option. Defaults to "production" on mainnet and "staging" on testnet;
# override if that guess doesn't match what your citizen-sdk version expects.
NEXT_PUBLIC_GOODDOLLAR_SDK_ENV=

APP_SECRET=
LESSON_REWARD_G=0.25
CHECKPOINT_REWARD_G=2
DAILY_CAP_G=2
LEAGUE_BONUS_1_G=2
LEAGUE_BONUS_2_G=1.5
LEAGUE_BONUS_3_G=1
VAULT_DEPLOY_BLOCK=0
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://github.com/sammajayi/learnit
CRON_SECRET=
# Wallets (comma separated) allowed to open the admin People list. Each signs a message to prove it holds the key.
# Leave empty to switch the list off: the endpoint then refuses everyone.
ADMIN_WALLETS=


# Public site on the apex domain, app on a subdomain. Both point at the same deployment.
# Leave unset in local dev. App routes on any other host redirect to NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_APP_URL=
# The public marketing site (the logo on the app's sign-in screen links here).
NEXT_PUBLIC_SITE_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=LearnIt <notifications@uselearnit.xyz>
APP_URL=https://www.uselearnit.xyz
# local hour (0-23), in each user's own timezone, that the stake-at-risk email check runs at. Same
# default as the push reminder's hour, so a staker who gets both hears from them together.
RISK_REMINDER_HOUR=18

